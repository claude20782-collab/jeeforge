# Copy to .env and fill in. NEVER commit real secrets.
DATABASE_URL=file:/absolute/path/to/db/custom.db
JWT_SECRET=generate-a-long-random-hex
INTERNAL_API_KEY=generate-a-random-hex
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong-password-here
NEXT_PUBLIC_CHAT_URL=  # empty in sandbox (uses ?XTransformPort=3003); absolute chat service URL in production
